#!/bin/sh
# lid-awake – notebook běží dál i se zavřeným víkem.
unit=lid-awake.service

is_on() { systemctl --user -q is-active "$unit"; }

case "${1:-status}" in
    on)     systemctl --user start "$unit" ;;
    off)    systemctl --user stop "$unit" ;;
    toggle) if is_on; then systemctl --user stop "$unit"; else systemctl --user start "$unit"; fi ;;
    status) ;;
    *)      echo "použití: lid-awake [on|off|toggle|status]" >&2; exit 2 ;;
esac

if is_on; then
    echo "zapnuto – zavřené víko notebook neuspí"
else
    echo "vypnuto – zavřené víko notebook uspí (výchozí chování)"
fi
